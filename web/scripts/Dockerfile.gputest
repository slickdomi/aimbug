# Headless Chromium + Mesa Vulkan (RADV/ANV) for running the smoke test on the host GPU:
#   docker build -t aimbug-gputest -f web/scripts/Dockerfile.gputest web/scripts
#   docker run --rm --device /dev/dri/renderD128 ... aimbug-gputest
# apt packages come from a dated snapshot.debian.org mirror (dependency cooldown).
FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

ARG SNAPSHOT=20260801T000000Z
ARG NPM_BEFORE=2026-08-28

RUN . /etc/os-release \
 && rm -f /etc/apt/sources.list.d/debian.sources \
 && printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%s %s main\ndeb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/%s %s-security main\n' \
      "$SNAPSHOT" "$VERSION_CODENAME" "$SNAPSHOT" "$VERSION_CODENAME" > /etc/apt/sources.list \
 && apt-get -o Acquire::Retries=5 update \
 && apt-get install -y --no-install-recommends chromium mesa-vulkan-drivers libvulkan1 nodejs npm fonts-dejavu-core ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /runner
RUN npm init -y >/dev/null && npm install --no-audit --no-fund --before="$NPM_BEFORE" playwright-core
ENV CHROMIUM=/usr/bin/chromium
